# ESP32 "Cheap Yellow Display" (ESP32-2432S028R and clones such as the ELEGOO
# E32R28T): ESP32-WROOM-32, 4 MB flash, no PSRAM, ILI9341 240x320 on SPI,
# XPT2046 resistive touch on its own pins, CH340 USB serial.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# No Bluetooth: it costs ~120 KB of RAM this chip does not have to spare
# alongside WiFi and the screen.
CONFIG_BT_ENABLED=n

# LVGL: allocate with malloc rather than a fixed pool, so the UI and WiFi
# share one heap.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_DEFAULT_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_OBSERVER=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# IRAM is small on the classic ESP32; keep WiFi's receive path in flash.
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# RAM. With no PSRAM, WiFi, the web server and the screen share about 150 KB
# of heap. Fewer WiFi buffers and no aggregation trade throughput a display
# does not need for room.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
