# Your Home Assistant, and a long-lived access token from it
# (your profile > Security > Long-lived access tokens).
HA_URL=http://homeassistant.local:8123
HA_TOKEN=paste-the-token-here
# Optional: only these addresses may open the admin page (comma-separated, CIDR allowed).
# HUB_ADMIN_FROM=192.168.1.0/24
